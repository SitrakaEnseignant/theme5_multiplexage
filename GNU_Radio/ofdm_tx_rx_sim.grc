options:
  parameters:
    author: Thème 5 - multiplexage OFDM (simulation pure)
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Chaîne OFDM 802.11a simplifiée : 64 porteuses, préfixe de 16 échantillons, 48 porteuses de données en QPSK, 4 pilotes, 2 symboles d''apprentissage par trame. Aucun matériel de radio logicielle.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: ofdm_tx_rx_sim
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 'OFDM : émetteur, canal à trajets multiples et récepteur (simulation)'
    window_size: (1300,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
